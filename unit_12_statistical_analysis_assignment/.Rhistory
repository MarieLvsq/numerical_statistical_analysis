scale_x_discrete(labels = c("1" = "Male", "2" = "Female")) +  # Map 1 = Male, 2 = Female
theme_minimal()
# Filter out rows where htval is non-finite (e.g., NA, Inf)
data_clean_height <- data[!is.na(data$htval) & is.finite(data$htval), ]
