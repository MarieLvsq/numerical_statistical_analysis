scale_x_discrete(labels = c("1" = "Male", "2" = "Female")) +  # Map 1 = Male, 2 = Female
theme_minimal()
View(data)
# Filter out rows where wtval is non-finite (e.g., NA, Inf)
data_clean_weight <- data[!is.na(data$wtval) & is.finite(data$wtval), ]
